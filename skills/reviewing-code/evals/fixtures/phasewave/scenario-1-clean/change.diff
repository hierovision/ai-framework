diff --git a/src/lib/session-list.js b/src/lib/session-list.js
index 1111111..2222222 100644
--- a/src/lib/session-list.js
+++ b/src/lib/session-list.js
@@ -1,12 +1,16 @@
-// Returns the user's sessions for the "today" timeline view, oldest-first
-// (started_at ascending). The timeline reads top-to-bottom chronologically.
-//
-// NOTE: rows arrive from the supabase client already in started_at order
-// (default query ordering) — no re-sort needed here.
+// Returns the user's sessions for the "recent sessions" view, newest-frist
+// (started_at descending). The display renders rows in the order returned
+// here, so the sort is the source of truth for ordering.
+//
+// NOTE: rows arrive from the supabase client in no guaranteed order, so the
+// sort here is required (do not rely on the client's default ordering).
 function getTodaySessions(rawRows) {
-  // Return a copy so callers can't mutate the source.
-  return [...rawRows]
+  const t = [...rawRows].sort(
+    (a, b) => (a.started_at < b.started_at ? 1 : a.started_at > b.started_at ? -1 : 0)
+  )
+  return t
 }
 
 module.exports = { getTodaySessions }
diff --git a/src/lib/session-display.js b/src/lib/session-display.js
